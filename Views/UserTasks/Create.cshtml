@model TaskManager.Models.UserTask

@{
    ViewData["Title"] = "Create Task";
}

<div class="row justify-content-center animate-fade-in-up">
    <div class="col-lg-7 col-md-9">
        <div class="glass-card shadow-lg">
            <!-- Header with Gradient Accent -->
            <div class="card-header-gradient py-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 small">
                        <i class="bi bi-plus-circle-fill"></i> New Task
                    </span>
                </div>
                <h2 class="fw-bold mb-1 fs-3">Create New Task</h2>
                <p class="text-muted small mb-0">Specify priorities, context, and deadlines to stay organized.</p>
            </div>

            <!-- Form Body -->
            <div class="p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4" role="alert"></div>

                    <!-- Task Title -->
                    <div class="form-floating-modern mb-3">
                        <label asp-for="Title" class="form-label">
                            <i class="bi bi-fonts text-primary"></i> Task Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control form-control-modern" placeholder="e.g. Complete quarterly financial review..." autofocus />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Task Description -->
                    <div class="form-floating-modern mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Description" class="form-label mb-0">
                                <i class="bi bi-card-text text-primary"></i> Description <span class="text-muted small fw-normal">(Optional)</span>
                            </label>
                            <span id="descCharCounter" class="text-muted small">0 / 500 characters</span>
                        </div>
                        <textarea asp-for="Description" id="taskDescriptionInput" class="form-control form-control-modern" rows="3" maxlength="500" placeholder="Add extra context, deliverables, or checklist notes..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Priority & Category Row -->
                    <div class="row g-3 mb-3">
                        <!-- Priority -->
                        <div class="col-sm-6">
                            <div class="form-floating-modern mb-0">
                                <label asp-for="Priority" class="form-label">
                                    <i class="bi bi-flag-fill text-warning"></i> Priority Level
                                </label>
                                <select asp-for="Priority" class="form-select form-control-modern" asp-items="Html.GetEnumSelectList<TaskManager.Models.TaskPriority>()">
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="col-sm-6">
                            <div class="form-floating-modern mb-0">
                                <label asp-for="Category" class="form-label">
                                    <i class="bi bi-tags-fill text-info"></i> Category
                                </label>
                                <select asp-for="Category" class="form-select form-control-modern" asp-items="Html.GetEnumSelectList<TaskManager.Models.TaskCategory>()">
                                </select>
                                <span asp-validation-for="Category" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Status & Due Date Row -->
                    <div class="row g-3 mb-4">
                        <!-- Status -->
                        <div class="col-sm-6">
                            <div class="form-floating-modern mb-0">
                                <label asp-for="Status" class="form-label">
                                    <i class="bi bi-clock-history text-primary"></i> Initial Status
                                </label>
                                <select asp-for="Status" class="form-select form-control-modern" asp-items="Html.GetEnumSelectList<TaskManager.Models.TaskStatus>()">
                                </select>
                                <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Due Date -->
                        <div class="col-sm-6">
                            <div class="form-floating-modern mb-0">
                                <label asp-for="DueDate" class="form-label">
                                    <i class="bi bi-calendar-event text-danger"></i> Due Date (Deadline)
                                </label>
                                <input asp-for="DueDate" type="date" class="form-control form-control-modern" />
                                <span asp-validation-for="DueDate" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Form Action Buttons -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
                        <a asp-action="Index" class="btn btn-modern-secondary order-2 order-sm-1">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-gradient-primary btn-shimmer order-1 order-sm-2">
                            <i class="bi bi-plus-lg"></i> Create Task
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const descInput = document.getElementById('taskDescriptionInput');
        const counter = document.getElementById('descCharCounter');
        if (descInput && counter) {
            descInput.addEventListener('input', () => {
                counter.textContent = `${descInput.value.length} / 500 characters`;
            });
        }
    </script>
}
