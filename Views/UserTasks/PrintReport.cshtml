@model IEnumerable<TaskManager.Models.UserTask>

@{
    ViewData["Title"] = "Tasks Export Summary";
    Layout = null; // Clean standalone printable page
    var taskList = Model?.ToList() ?? new List<TaskManager.Models.UserTask>();
    var total = taskList.Count;
    var completed = taskList.Count(t => t.Status == TaskManager.Models.TaskStatus.Completed);
    var inProgress = taskList.Count(t => t.Status == TaskManager.Models.TaskStatus.InProgress);
    var todo = taskList.Count(t => t.Status == TaskManager.Models.TaskStatus.Todo);
    var overdue = taskList.Count(t => t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != TaskManager.Models.TaskStatus.Completed);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TaskManager - Printable Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            color: #1e293b;
            background: #f8fafc;
            padding: 30px;
        }
        .report-header {
            border-bottom: 2px solid #6366f1;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .report-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            padding: 20px;
            margin-bottom: 25px;
        }
        .badge-status {
            padding: 4px 8px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .status-todo { background: #f1f5f9; color: #475569; }
        .status-in-progress { background: #e0f2fe; color: #0369a1; }
        .status-completed { background: #dcfce7; color: #15803d; }
        
        .prio-urgent { color: #e11d48; font-weight: bold; }
        .prio-high { color: #d97706; font-weight: bold; }
        .prio-medium { color: #0284c7; }
        .prio-low { color: #16a34a; }

        @@media print {
            body { background: #ffffff; padding: 0; }
            .no-print { display: none !important; }
            .report-card { box-shadow: none; border: none; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="container-fluid" style="max-width: 900px;">
        <!-- Top Toolbar -->
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <a href="/UserTasks" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to App
            </a>
            <button onclick="window.print()" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
            </button>
        </div>

        <div class="report-card">
            <!-- Header -->
            <div class="report-header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1" style="color: #4f46e5;">TaskManager Summary Report</h2>
                    <p class="text-muted small mb-0">Generated for <strong>@ViewBag.UserName</strong> (@ViewBag.UserEmail) &bull; @ViewBag.GeneratedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                </div>
                <div class="text-end">
                    <span class="fs-4 fw-bold text-primary">@total</span>
                    <span class="text-muted small d-block">Total Tasks</span>
                </div>
            </div>

            <!-- Summary Badges -->
            <div class="row g-2 mb-4 text-center">
                <div class="col-3">
                    <div class="p-2 border rounded">
                        <div class="fs-5 fw-bold text-secondary">@todo</div>
                        <div class="small text-muted text-uppercase" style="font-size: 10px;">To Do</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-2 border rounded">
                        <div class="fs-5 fw-bold text-info">@inProgress</div>
                        <div class="small text-muted text-uppercase" style="font-size: 10px;">In Progress</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-2 border rounded">
                        <div class="fs-5 fw-bold text-success">@completed</div>
                        <div class="small text-muted text-uppercase" style="font-size: 10px;">Completed</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-2 border rounded @(overdue > 0 ? "border-danger bg-danger-subtle" : "")">
                        <div class="fs-5 fw-bold @(overdue > 0 ? "text-danger" : "text-muted")">@overdue</div>
                        <div class="small text-muted text-uppercase" style="font-size: 10px;">Overdue</div>
                    </div>
                </div>
            </div>

            <!-- Task List Table -->
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr style="font-size: 12px; text-transform: uppercase;">
                        <th>Task</th>
                        <th style="width: 110px;">Status</th>
                        <th style="width: 90px;">Priority</th>
                        <th style="width: 90px;">Category</th>
                        <th style="width: 110px;">Due Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!taskList.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No tasks found.</td>
                        </tr>
                    }
                    @foreach (var task in taskList)
                    {
                        var isDone = task.Status == TaskManager.Models.TaskStatus.Completed;
                        var isOverdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && !isDone;
                        var prioClass = task.Priority switch {
                            TaskManager.Models.TaskPriority.Urgent => "prio-urgent",
                            TaskManager.Models.TaskPriority.High => "prio-high",
                            TaskManager.Models.TaskPriority.Medium => "prio-medium",
                            _ => "prio-low"
                        };
                        var statusClass = task.Status switch {
                            TaskManager.Models.TaskStatus.Completed => "status-completed",
                            TaskManager.Models.TaskStatus.InProgress => "status-in-progress",
                            _ => "status-todo"
                        };

                        <tr>
                            <td>
                                <div class="fw-semibold @(isDone ? "text-decoration-line-through text-muted" : "")">@task.Title</div>
                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <div class="small text-muted">@task.Description</div>
                                }
                                @if (task.SubTasks?.Any() == true)
                                {
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-list-check"></i> Steps: @task.SubTasks.Count(s => s.IsCompleted) of @task.SubTasks.Count done
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge-status @statusClass">@task.Status</span>
                            </td>
                            <td>
                                <span class="@prioClass">@task.Priority</span>
                            </td>
                            <td class="small">
                                @task.Category
                            </td>
                            <td class="small @(isOverdue ? "text-danger fw-bold" : "")">
                                @(task.DueDate.HasValue ? task.DueDate.Value.ToString("MMM dd, yyyy") : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
