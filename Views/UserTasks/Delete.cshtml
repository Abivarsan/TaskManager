@model TaskManager.Models.UserTask

@{
    ViewData["Title"] = "Delete Task";
}

<div class="row justify-content-center animate-fade-in-up">
    <div class="col-lg-6 col-md-8">
        <div class="glass-card">
            <!-- Header with Danger Accent -->
            <div class="card-header-gradient" style="border-top: 3px solid var(--danger);">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-0.5 small">
                        <i class="bi bi-exclamation-triangle-fill"></i> Confirmation Required
                    </span>
                </div>
                <h2 class="fw-bold mb-1 fs-3">Delete Task</h2>
                <p class="text-muted small mb-0">This action cannot be undone. Please confirm you want to proceed.</p>
            </div>

            <!-- Delete Confirmation Body -->
            <div class="p-4 p-md-5">
                <div class="p-4 rounded-3 mb-4" style="background: var(--danger-bg); border: 1px solid rgba(244, 63, 94, 0.25);">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="text-danger fs-3 mt-1">
                            <i class="bi bi-trash3-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-danger mb-2">Are you sure you want to delete this task?</h5>
                            <h6 class="fw-bold text-main mb-2">@Model.Title</h6>
                            <p class="text-muted small mb-0">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                            </p>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="UserTaskId" />
                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 pt-2">
                        <a asp-action="Index" class="btn btn-modern-secondary order-2 order-sm-1">
                            <i class="bi bi-arrow-left"></i> Cancel & Keep
                        </a>
                        <button type="submit" class="btn btn-modern-danger order-1 order-sm-2">
                            <i class="bi bi-trash3"></i> Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
