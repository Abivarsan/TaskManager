@inject Microsoft.AspNetCore.Identity.UserManager<TaskManager.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskManager</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Custom Modern UI Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Modern Sticky Navbar -->
    <nav class="navbar navbar-expand-lg modern-navbar">
        <div class="container">
            <!-- Brand Logo -->
            <a class="brand-logo-container" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="brand-icon-box">
                    <i class="bi bi-check2-square"></i>
                </div>
                <span>Task<span class="brand-text-gradient">Manager</span></span>
            </a>

            <!-- Mobile Navbar Toggle -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-main"></i>
            </button>

            <!-- Navigation Links -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link-modern" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link-modern" asp-area="" asp-controller="UserTasks" asp-action="Index">
                                <i class="bi bi-kanban"></i> My Tasks
                            </a>
                        </li>
                    }
                </ul>

                <!-- Right-aligned Items -->
                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                    <!-- Theme Mode Toggle -->
                    <button type="button" class="btn-theme-toggle" id="themeToggleBtn" aria-label="Toggle light or dark theme" title="Toggle theme">
                        <i class="bi bi-sun-fill text-warning"></i>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = !string.IsNullOrWhiteSpace(currentUser?.DisplayName) ? currentUser.DisplayName : (User.Identity.Name ?? "User");
                        var initial = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "U";

                        <!-- Quick Add Task Shortcut -->
                        <a asp-controller="UserTasks" asp-action="Create" class="btn btn-gradient-primary btn-sm d-none d-sm-inline-flex">
                            <i class="bi bi-plus-lg"></i> New Task
                        </a>

                        <!-- User Profile Pill -->
                        <a asp-controller="Profile" asp-action="Index" class="user-profile-badge text-decoration-none" title="Manage Profile & Settings">
                            <div class="user-avatar">
                                @initial
                            </div>
                            <span class="d-none d-md-inline">@displayName</span>
                        </a>

                        <!-- Logout Button -->
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="d-inline m-0">
                            <button type="submit" class="btn-action-icon delete-icon" title="Log out">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link-modern" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </a>
                        <a class="btn btn-gradient-primary btn-sm btn-shimmer" asp-area="Identity" asp-page="/Account/Register">
                            <i class="bi bi-person-plus"></i> Get Started
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="container main-container" role="main">
        @RenderBody()
    </main>

    <!-- Modern Footer -->
    <footer class="modern-footer">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold brand-text-gradient">TaskManager</span>
                    <span>&copy; @DateTime.Now.Year. All rights reserved.</span>
                </div>
                <div class="d-flex gap-4 text-muted small">
                    <span><i class="bi bi-shield-check text-success"></i> Secure Storage</span>
                    <span><i class="bi bi-lightning-charge text-warning"></i> Fast Performance</span>
                    <span><i class="bi bi-moon-stars text-primary"></i> Dark/Light Mode</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    
    <!-- Custom UI Enhancements -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
