@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="glass-card shadow-lg mt-4 text-center">
            <div class="card-header-gradient py-4">
                <div class="brand-icon-box mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.75rem; background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
                <h2 class="h4 fw-bold mb-1">Check Your Email</h2>
                <p class="text-muted small mb-0">Password reset instructions sent</p>
            </div>

            <div class="p-4 p-md-5">
                <div class="alert alert-info border-0 rounded-3 mb-4 text-start" style="background: rgba(14, 165, 233, 0.1); color: var(--text-main);">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-info-circle-fill text-info fs-5"></i>
                        <span class="fw-semibold">Instructions Sent</span>
                    </div>
                    <p class="small mb-0 text-muted">
                        If an account exists with that email address, an email has been sent with a link to reset your password.
                    </p>
                </div>

                <p class="text-muted small mb-4">
                    Be sure to check your spam or junk folder if you don't see the email within a few minutes.
                </p>

                <div class="d-flex flex-column gap-2">
                    <a asp-page="./Login" class="btn btn-gradient-primary btn-shimmer py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Return to Sign In
                    </a>
                    <a asp-page="./ForgotPassword" class="btn btn-modern-secondary py-2">
                        <i class="bi bi-arrow-repeat me-2"></i> Try Another Email
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
