@page
@model RegisterModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="glass-card shadow-lg mt-4">
            <!-- Card Header -->
            <div class="card-header-gradient text-center py-4">
                <div class="brand-icon-box mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h2 class="h4 fw-bold mb-1">Create Account</h2>
                <p class="text-muted small mb-0">Join TaskManager and elevate your daily productivity</p>
            </div>

            <!-- Card Body -->
            <div class="p-4 p-md-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 px-3 small mb-4" role="alert"></div>

                    <!-- Email Input -->
                    <div class="form-floating-modern mb-3">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="bi bi-envelope me-1 text-primary"></i> Email Address
                        </label>
                        <input asp-for="Input.Email" class="form-control form-control-modern" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-floating-modern mb-3">
                        <label asp-for="Input.Password" class="form-label">
                            <i class="bi bi-key me-1 text-primary"></i> Password
                        </label>
                        <input asp-for="Input.Password" class="form-control form-control-modern" autocomplete="new-password" aria-required="true" placeholder="Create a strong password" />
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text small text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i> Must be at least 6 characters long with letters, digits, and special characters.
                        </div>
                    </div>

                    <!-- Confirm Password Input -->
                    <div class="form-floating-modern mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">
                            <i class="bi bi-shield-check me-1 text-primary"></i> Confirm Password
                        </label>
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-modern" autocomplete="new-password" aria-required="true" placeholder="Confirm your password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit CTA -->
                    <button id="registerSubmit" type="submit" class="btn btn-gradient-primary btn-shimmer w-100 py-3 mb-3">
                        <i class="bi bi-rocket-takeoff me-2"></i> Create Account
                    </button>

                    <!-- Switch to Sign In -->
                    <div class="text-center pt-2 border-top" style="border-color: var(--border-color) !important;">
                        <p class="text-muted small mb-0 mt-3">
                            Already have an account?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold brand-text-gradient text-decoration-none ms-1">
                                Sign In
                            </a>
                        </p>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="position-relative my-4 text-center">
                        <hr class="text-muted" />
                        <span class="position-absolute top-50 start-50 translate-middle px-3 text-muted small" style="background: var(--bg-surface);">
                            Or register with
                        </span>
                    </div>

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-modern-secondary w-100 py-2" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
