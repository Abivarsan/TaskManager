@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="glass-card shadow-lg mt-4">
            <div class="card-header-gradient text-center py-4">
                <div class="brand-icon-box mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h2 class="h4 fw-bold mb-1">Forgot Password?</h2>
                <p class="text-muted small mb-0">Enter your registered email address and we'll send you a secure password reset link.</p>
            </div>
            
            <div class="p-4 p-md-5">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating-modern mb-4">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="bi bi-envelope me-1 text-primary"></i> Email Address
                        </label>
                        <input asp-for="Input.Email" class="form-control form-control-modern" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-gradient-primary btn-shimmer w-100 py-3 mb-3">
                        <i class="bi bi-send me-2"></i> Send Reset Link
                    </button>

                    <div class="text-center mt-3">
                        <a asp-page="./Login" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
