@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="glass-card shadow-lg mt-4 text-center">
            <div class="card-header-gradient py-4">
                <div class="brand-icon-box mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.75rem; background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h2 class="h4 fw-bold mb-1">Password Changed!</h2>
                <p class="text-muted small mb-0">Your account is ready with your new password.</p>
            </div>

            <div class="p-4 p-md-5">
                <div class="alert alert-success border-0 rounded-3 mb-4 text-start" style="background: rgba(16, 185, 129, 0.1); color: var(--text-main);">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span class="fw-semibold">Security Updated</span>
                    </div>
                    <p class="small mb-0 text-muted">
                        Your password has been successfully reset. You can now use your new password to sign into your TaskManager account.
                    </p>
                </div>

                <a asp-page="./Login" class="btn btn-gradient-primary btn-shimmer w-100 py-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In to Account
                </a>
            </div>
        </div>
    </div>
</div>
